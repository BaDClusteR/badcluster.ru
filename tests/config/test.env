; The environment of the tests: it replaces .env.local (see tests/Support/TestEnvironment.php), so the tests never
; get the credentials of a real database, the backup destinations or the Slack hooks.
APP_DEBUG=false

; Only the critical errors that require immediate action: the logger of Runway writes to PROJECT_ROOT/log.
LOG_LEVEL=6

; Only SQLite: TestEnvironment refuses any other DSN.
DSN="sqlite::memory:"
DB_USER=
DB_PASSWORD=
DB_PREFIX="bc_"

WEB_ROOT="http://bc.test"

; No Secret: it is a private submodule (not in the CI) and sends messages to Slack.
MODULES="Blog,Games,Books,Music,Backup"

NODE_PATH=
VIPSTHUMBNAIL_PATH=

API_TOKEN_HEADER="X-BC-Token"
API_AUTH_ENABLED=true
API_ALLOW_ORIGIN=
TRUSTED_PROXIES=
