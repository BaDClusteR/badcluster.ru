{
    "$schema": "vendor/infection/infection/resources/schema.json",
    // The code with solid unit tests: the logic of the core and the modules. The controllers, the endpoints, the
    // page widgets and the templates are covered by the integration and E2E tests, which the mutation testing does
    // not run (they boot the container and the PHP built-in server).
    "source": {
        "directories": [
            "src/Core/Action",
            "src/Core/Asset/Minifier",
            "src/Core/Command",
            "src/Core/Comment",
            "src/Core/Converter",
            "src/Core/Formatter",
            "src/Core/Helper",
            "src/Core/Log",
            "src/Core/Scanner",
            "src/Core/Shortcode",
            "src/Core/SystemMetrics",
            "src/Core/Typography",
            "src/Exception",
            "src/Logger",
            "modules/Backup/src",
            "modules/Blog/src/Api/DataBuilder",
            "modules/Blog/src/Core/Action",
            "modules/Blog/src/Model",
            "modules/Blog/src/Provider",
            "modules/Books/src/Api/DataBuilder",
            "modules/Books/src/Core",
            "modules/Books/src/Format",
            "modules/Books/src/Model",
            "modules/Books/src/Provider",
            "modules/Books/src/Widget/Format",
            "modules/Games/src/Api/DataBuilder",
            "modules/Games/src/Core",
            "modules/Games/src/Model",
            "modules/Games/src/Provider",
            "modules/Music/src/Api/DataBuilder",
            "modules/Music/src/Model",
            "modules/Music/src/Provider"
        ]
    },
    "testFramework": "phpunit",
    // Composer may print deprecation notices instead of its bin-dir, so the path is explicit.
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFrameworkOptions": "--testsuite=unit",
    "tmpDir": "var/infection",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log"
    },
    "minMsi": 90,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true,
        // The methods are protected on purpose: they are the extension points for the subclasses.
        "ProtectedVisibility": false
    }
}
