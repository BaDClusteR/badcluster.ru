{
  "private": true,
  "license": "CC0-1.0",
  "require": {
    "php": ">=8.5",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-yaml": "*",
    "ext-zip": "*",
    "bad_cluster/runway": "^2.0.1",
    "matthiasmullie/minify": "^1.3",
    "bad_cluster/runway-api-platform": "^2.0",
    "bad_cluster/runway-console-app": "^1.0.1",
    "james-heinrich/getid3": "^1.9",
    "ext-gd": "*",
    "bad_cluster/runway-queue-manager": "^1.0.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3",
    "infection/infection": "^0.35",
    "ext-pdo_sqlite": "*"
  },
  "autoload": {
    "psr-4": {
      "BC\\": "src/",
      "BC\\Modules\\Blog\\": "modules/Blog/src/",
      "BC\\Modules\\Games\\": "modules/Games/src/",
      "BC\\Modules\\Books\\": "modules/Books/src/",
      "BC\\Modules\\Music\\": "modules/Music/src/",
      "BC\\Modules\\Secret\\": "modules/Secret/src",
      "BC\\Modules\\Backup\\": "modules/Backup/src/"
    },
    "files": [
      "bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BC\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:e2e": "phpunit --testsuite e2e",
    "phpstan": "phpstan --memory-limit=2G",
    "infection": "infection --threads=max"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
